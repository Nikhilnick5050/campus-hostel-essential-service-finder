# ---- Supabase (PostgreSQL) ----
# Optional. If left empty, the app uses a local JSON file (data/services.json)
# so it runs instantly for a demo. For production persistence (e.g. on Vercel),
# create a free Supabase project and paste the values below.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Admin login ----
# Change these before deploying. The password is hashed at runtime (bcrypt).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Session signing secret ----
# Use any long random string. Change this in production.
AUTH_SECRET=change-me-to-a-long-random-string